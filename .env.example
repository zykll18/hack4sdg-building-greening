# Server-only configuration. Leave blank while using local rules.
# Vite supplies a local-only policy; public activation requires production authorization.
QWEN_MODEL=qwen3.7-plus
QWEN_API_KEY=
# Copy the OpenAI-compatible URL from your Qwen/Model Studio platform, ending /compatible-mode/v1.
# The endpoint and API key must match the same platform/region/workspace.
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# Production demo access: generate a random code of at least 24 characters.
AI_DEMO_ACCESS_CODE=
# Shared durable quotas: use a dedicated Upstash Redis database with no eviction.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global limits across all demo visitors. Daily reset: UTC midnight (08:00 HK).
AI_REQUESTS_PER_MINUTE=3
AI_REQUESTS_PER_DAY=20
# Never rename these to VITE_* or put secrets in browser storage.
